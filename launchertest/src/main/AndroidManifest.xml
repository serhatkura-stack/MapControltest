<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hava durumu (Open-Meteo). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Araç verisini okumak için araç veri servisine bağlanma. -->
    <uses-permission android:name="ivi.vds.permission.SERVICE" />
    <!-- Alt şeritteki uygulama seçicisi. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Fotoğraf widget'ı: İndirilenler klasöründeki resimleri listeler. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Navigasyon kartı: Ev / İş için o anki GPS konumu. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <queries>
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Launcher Test"
        android:supportsRtl="true">

        <!-- HOME kategorisi yok: aracın kendi ana ekranı değişmez; uygulama listesinden açılır. -->
        <activity
            android:name=".launcher.HomeLauncherActivity"
            android:exported="true"
            android:label="Launcher Test"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tek seferlik HUD testi: intent-filter YOK (yalnızca açık bileşen adıyla başlatılır).
             exported=false iken adb shell (uid 2000) başlatamıyor (emülatörde SecurityException), bu yüzden
             exported=true; koruma kodda: "ack" onay ekstrası + başlatan paket denetimi + park kapısı. -->
        <activity
            android:name="com.mapcontrol.hud.HudTestActivity"
            android:exported="true"
            android:label="HUD Test"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Konfor yazma testi (perde, buğu, direksiyon ısıtma): HUD testiyle aynı koruma deseni
             (intent-filter yok, exported=true, ack + shell başlatan denetimi + park kapısı kodda). -->
        <activity
            android:name="com.mapcontrol.comfort.ComfortTestActivity"
            android:exported="true"
            android:label="Konfor Test"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Ekranı karart: tam siyah, en düşük parlaklık; dokununca kapanır. -->
        <activity
            android:name=".launcher.ScreenOffActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Medya kartı: çalan şarkıyı okumak için bildirim erişimi (kullanıcı ayarlardan verir). -->
        <service
            android:name=".media.LauncherMediaNotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Yandex -> HUD köprüsü (isteğe bağlı): yalnızca ru.yandex.yandexmaps, kullanıcı bir kez etkinleştirir
             (adb komutu için bkz. NOTLAR). Ayarlarda "Yandex -> HUD" Kapalı iken hiçbir şey okunmaz/gönderilmez. -->
        <service
            android:name="com.mapcontrol.hud.YandexHudAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hud_accessibility_config" />
        </service>
    </application>
</manifest>
